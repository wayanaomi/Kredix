# Database — PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Session / authentication
SESSION_COOKIE_NAME="kredix_session"
SESSION_SECRET="replace-with-a-long-random-secret"

# Development-only providers must remain disabled in production
ALLOW_DEV_PROVIDERS="false"

# Payments — Paystack
PSP_PROVIDER="paystack"
PSP_SECRET_KEY=""
PSP_PUBLIC_KEY=""
PSP_WEBHOOK_SECRET=""

# Notifications
NOTIFICATIONS_PROVIDER="none"
NOTIFICATIONS_API_KEY=""
NOTIFICATIONS_FROM=""

# Public application URL
NEXT_PUBLIC_APP_URL="https://your-kredix-domain.com"
